# 复制为 deploy/.env 后填写。该文件权限必须是 600，且不要提交。
ASPNETCORE_ENVIRONMENT=Production
IBTRADE_DB_HOST=db
IBTRADE_DB_PORT=5432
IBTRADE_DB_NAME=ibtrade
IBTRADE_DB_USER=ibtrade
IBTRADE_DB_PASSWORD=change-me
IBTRADE_API_KEY=change-me
TWS__Enabled=false
TWS__Mode=Paper

# 可选：IBKR Flex 与模型密钥。没有这些时页面能打开，但拉不到持仓、也不能调用模型。
# IBKR_FLEX_TOKEN_LIVE=
# IBKR_FLEX_QUERYID_LIVE=
# IBKR_FLEX_TOKEN_PAPER=
# IBKR_FLEX_QUERYID_PAPER=
# DASHSCOPE_API_KEY=
