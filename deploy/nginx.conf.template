server {
    listen 8080;
    server_tokens off;
    client_max_body_size 2m;
    absolute_redirect off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    location = /health {
        proxy_pass http://api:8090/health;
        access_log off;
    }

    location /api/ {
        auth_basic "IBTrade";
        auth_basic_user_file /etc/nginx/htpasswd;
        proxy_pass http://api:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Api-Key "${IBTRADE_API_KEY}";
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    location / {
        auth_basic "IBTrade";
        auth_basic_user_file /etc/nginx/htpasswd;
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
